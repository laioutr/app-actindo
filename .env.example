# Per-tenant Bearer API key for the Actindo Storefront Data Service.
# Resolves server-side to exactly one Actindo tenant. Keep this secret.
# https://laioutr.actindo.com/docs#/
ACTINDO_API_KEY=

# Optional: override the service base URL (defaults to the value below).
# Configure via the module's `baseUrl` option in nuxt.config if you need this.
# ACTINDO_BASE_URL=https://laioutr.actindo.com
